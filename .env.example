# === Credenciales de la app de Uber (3PL Consumer API) ===
# client_id = "Application ID" del panel de Uber. No es secreto.
UBER_CLIENT_ID=
# client_secret = SECRETO. Solo aquí (este archivo NO; usa .env, que está en .gitignore).
UBER_CLIENT_SECRET=
# Scope(s) que requiera el 3PL Consumer API (mira la referencia de la API en tu panel).
# Déjalo vacío si tu app no requiere scope.
UBER_SCOPE=

# === OAuth / endpoints (ajusta a la referencia real del 3PL Consumer API) ===
# OJO: sandbox y producción usan hosts de auth distintos.
UBER_TOKEN_URL_SANDBOX=https://sandbox-login.uber.com/oauth/v2/token
UBER_TOKEN_URL_PROD=https://auth.uber.com/oauth/v2/token
UBER_SANDBOX_BASE=https://test-api.uber.com
UBER_PROD_BASE=https://api.uber.com
# Rutas de la API. {id} se sustituye automáticamente. AJÚSTALAS a las reales.
UBER_DELIVERIES_PATH=/v1/deliveries
UBER_DELIVERY_PATH=/v1/deliveries/{id}

# === Backend (Express) ===
# Puerto del backend. Sirve /api (Uber + WhatsApp) y, en prod, el SPA compilado.
PORT=3001
# Base del backend para el front. Vacío = rutas relativas (/api) -> funciona en dev
# (Vite reenvía /api por proxy) y en prod (mismo origen). Defínelo SOLO si el front
# y el backend viven en orígenes distintos, p.ej. VITE_API_BASE=https://api.tudominio.com
VITE_API_BASE=

# === Supabase ===
# Project URL y anon key (Settings > API). La anon key es PÚBLICA (va en el front,
# protegida por RLS). En Vercel define estas dos como variables de entorno.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...
# El BACKEND usa estas mismas (sin prefijo VITE_) para validar el token en /api.
# En Railway define SUPABASE_URL y SUPABASE_ANON_KEY.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
